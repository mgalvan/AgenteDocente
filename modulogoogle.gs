// Agente Docente - modulo Google pronto alla creazione.
// 1. Apri https://script.google.com e crea un nuovo progetto.
// 2. Incolla tutto questo file in Codice.gs.
// 3. Esegui creaModuloGoogle e autorizza l'accesso a Google Moduli.
// 4. Nel registro trovi i link di modifica e compilazione.
// Le esecuzioni successive riaprono lo stesso modulo senza duplicarlo.
const MODULO_GOOGLE = {"title": "Quiz sulle Potenze nei Numeri Naturali", "questions": [{"title": "Quale affermazione descrive correttamente la potenza $$a^n$$?", "options": ["$$a$$ moltiplicato per $$n$$", "$$a$$ ripetuto $$n$$ volte in una somma", "$$a$$ moltiplicato per se stesso $$n$$ volte", "$$n$$ moltiplicato per se stesso $$a$$ volte"], "correct_index": 2, "points": 1, "image_base64": ""}, {"title": "Quanto vale qualsiasi numero naturale (diverso da zero) elevato a zero?", "options": ["$$0$$", "$$1$$", "Il numero stesso", "Non \u00e8 definito"], "correct_index": 1, "points": 1, "image_base64": ""}, {"title": "Quanto vale qualsiasi numero naturale elevato alla prima potenza?", "options": ["$$0$$", "$$1$$", "Il numero stesso", "Non \u00e8 definito"], "correct_index": 2, "points": 1, "image_base64": ""}, {"title": "Qual \u00e8 la regola per il prodotto di potenze con la stessa base, ad esempio $$a^m \\cdot a^n$$?", "options": ["$$a^{m+n}$$", "$$a^{m \\cdot n}$$", "$$(a \\cdot a)^{m+n}$$", "$$a^{m-n}$$"], "correct_index": 0, "points": 1, "image_base64": ""}, {"title": "Qual \u00e8 la regola per il quoziente di potenze con la stessa base, ad esempio $$a^m : a^n$$ (con $$a \\neq 0$$)?", "options": ["$$a^{m+n}$$", "$$a^{m \\cdot n}$$", "$$(a : a)^{m-n}$$", "$$a^{m-n}$$"], "correct_index": 3, "points": 1, "image_base64": ""}, {"title": "Qual \u00e8 la regola per la potenza di una potenza, ad esempio $$(a^m)^n$$?", "options": ["$$a^{m+n}$$", "$$a^{m \\cdot n}$$", "$$a^{m^n}$$", "$$(a \\cdot n)^m$$"], "correct_index": 1, "points": 1, "image_base64": ""}, {"title": "Qual \u00e8 la regola per il prodotto di potenze con lo stesso esponente, ad esempio $$a^n \\cdot b^n$$?", "options": ["$$(a+b)^n$$", "$$(a \\cdot b)^n$$", "$$a^{n+n}$$", "$$a \\cdot b^{n+n}$$"], "correct_index": 1, "points": 1, "image_base64": ""}, {"title": "Qual \u00e8 la regola per il quoziente di potenze con lo stesso esponente, ad esempio $$a^n : b^n$$ (con $$b \\neq 0$$)?", "options": ["$$(a-b)^n$$", "$$(a : b)^n$$", "$$a^{n-n}$$", "$$a : b^{n-n}$$"], "correct_index": 1, "points": 1, "image_base64": ""}, {"title": "Quanto vale $$0^n$$ per un numero naturale $$n$$ maggiore di $$0$$?", "options": ["$$n$$", "$$1$$", "$$0$$", "Non \u00e8 definito"], "correct_index": 2, "points": 1, "image_base64": ""}, {"title": "Quanto vale $$1^n$$ per qualsiasi numero naturale $$n$$?", "options": ["$$n$$", "$$1$$", "$$0$$", "Non \u00e8 definito"], "correct_index": 1, "points": 1, "image_base64": ""}]};

function creaModuloGoogle() {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const properties = PropertiesService.getScriptProperties();
    const key = 'agenteDocente:' + Utilities.base64EncodeWebSafe(
      Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, JSON.stringify(MODULO_GOOGLE)));
    const existing = properties.getProperty(key);
    if (existing) {
      const form = FormApp.openById(existing);
      console.log('Modifica: ' + form.getEditUrl());
      console.log('Compilazione: ' + form.getPublishedUrl());
      return form.getEditUrl();
    }
    const form = FormApp.create(MODULO_GOOGLE.title, true);
    try {
      form.setIsQuiz(true);
      form.setDescription('Quiz a risposta multipla. Seleziona una risposta per domanda.');
      MODULO_GOOGLE.questions.forEach((question, index) => {
        if (question.image_base64) {
          const image = Utilities.newBlob(Utilities.base64Decode(question.image_base64), 'image/png', 'domanda-' + (index + 1) + '.png');
          form.addImageItem().setTitle('Domanda ' + (index + 1))
            .setHelpText(question.title + '\n' + question.options.map((value, i) => 'Risposta ' + (i + 1) + ': ' + value).join('\n'))
            .setImage(image).setWidth(740);
        }
        const item = form.addMultipleChoiceItem();
        item.setTitle(question.image_base64 ? 'Domanda ' + (index + 1) + ' - Seleziona la risposta mostrata nell?immagine' : (index + 1) + '. ' + question.title);
        item.setRequired(true);
        item.setPoints(question.points);
        item.setChoices(question.options.map((value, i) => item.createChoice(question.image_base64 ? 'Risposta ' + (i + 1) : value, i === question.correct_index)));
        item.showOtherOption(false);
      });
      properties.setProperty(key, form.getId());
    } catch (error) {
      DriveApp.getFileById(form.getId()).setTrashed(true);
      throw error;
    }
    console.log('Modifica: ' + form.getEditUrl());
    console.log('Compilazione: ' + form.getPublishedUrl());
    return form.getEditUrl();
  } finally {
    lock.releaseLock();
  }
}
