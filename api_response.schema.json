          "type": "string"
        },
        "ref": {
          "description": "Identifier of the existing resource referenced by this block, selected by kind. This is the resource ID, not the block ID. Multiple blocks may reference the same resource, but must have distinct block IDs.",
          "title": "Ref",
          "type": "string"
        }
      },
