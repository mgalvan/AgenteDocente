    "Graph": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "geometry_2d is only for closed polygons with at least three vertices. Real-line intervals use function_2d with pieces: expression '0', explicit x_start/x_end and open/closed endpoints. Never encode intervals as geometry_2d or infer endpoint inclusion from alt_text.",
          "enum": [
            "function_2d",
            "scatter",
            "bar_chart",
            "geometry_2d"
          ],
          "title": "Kind",
          "type": "string"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "title": "Points",
          "type": "array"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        },
        "x_label": {
          "title": "X Label",
          "type": "string"
        },
        "y_label": {
          "title": "Y Label",
          "type": "string"
        },
        "alt_text": {
          "title": "Alt Text",
          "type": "string"
        },
        "pieces": {
          "description": "Function pieces with explicit domains, endpoint markers and excluded x coordinates. When used, expression is empty. points are additional filled points. For a real-line interval [a,b), use expression '0', x_start=a, x_end=b, start='closed', end='open', holes=[]; leave graph expression, points, labels, values and polygons empty. Endpoint inclusion must be encoded here, not only in alt_text.",
          "items": {
            "$ref": "#/$defs/CurvePiece"
          },
          "title": "Pieces",
          "type": "array"
        },
        "polygons": {
          "description": "geometry_2d only: ordered polygon vertices and label; closing edge is automatic.",
          "items": {
            "$ref": "#/$defs/Polygon"
          },
          "title": "Polygons",
          "type": "array"
        },
        "areas": {
          "description": "Filled regions between expression and baseline on [x_start,x_end]. Use explicit data, not alt_text.",
          "items": {
            "$ref": "#/$defs/Area"
          },
          "title": "Areas",
          "type": "array"
        },
        "rectangles": {
          "description": "Equal-width Riemann rectangles on [x_start,x_end], with explicit count and left/right/midpoint sampling.",
          "items": {
            "$ref": "#/$defs/Rectangles"
          },
          "title": "Rectangles",
          "type": "array"
        }
      },
